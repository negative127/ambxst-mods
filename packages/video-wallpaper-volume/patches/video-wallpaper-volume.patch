diff -u -r a/modules/globals/GlobalStates.qml b/modules/globals/GlobalStates.qml
--- a/modules/globals/GlobalStates.qml	2026-10-11 14:42:49.873979568 +0530
+++ b/modules/globals/GlobalStates.qml	2026-10-11 14:42:49.874092676 +0530
@@ -203,6 +203,20 @@
     // Persistent wallpaper navigation state
     property int wallpaperSelectedIndex: -1
 
+    // Video wallpaper audio state
+    property real videoWallpaperVolume: StateService.get("videoWallpaperVolume", 0.3)
+    property bool videoWallpaperMuted: StateService.get("videoWallpaperMuted", false)
+
+    function setVideoWallpaperVolume(vol) {
+        videoWallpaperVolume = Math.max(0.0, Math.min(1.0, vol));
+        if (StateService && StateService.initialized) StateService.set("videoWallpaperVolume", videoWallpaperVolume);
+    }
+
+    function setVideoWallpaperMuted(muted) {
+        videoWallpaperMuted = muted;
+        if (StateService && StateService.initialized) StateService.set("videoWallpaperMuted", muted);
+    }
+
     // Bumped to re-align video wallpapers across screens (seek to 0)
     property int videoSyncTick: 0
 
