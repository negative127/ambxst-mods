{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "negative.screenshot-fix",
  "name": "Screenshot Tool Fix",
  "version": "1.0.0",
  "description": "Fixes screenshot overlay freeze and deadlock on rapid re-triggers by adding session tracking, discarding stale capture callbacks, and ensuring reliable Loader activation.",
  "license": "MIT",
  "author": "negative",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.0 <2.0.0"
  },
  "permissions": [],
  "operations": [
    { "type": "patch", "source": "patches/screenshot-service.patch" },
    { "type": "patch", "source": "patches/screenshot-tool.patch" },
    { "type": "patch", "source": "patches/shell-loader.patch" }
  ]
}
